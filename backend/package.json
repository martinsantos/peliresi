{
  "name": "trazabilidad-rrpp-backend",
  "version": "1.0.0",
  "description": "Backend para Sistema de Trazabilidad de Residuos Peligrosos",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:migration:unit": "vitest run src/__tests__/utils/officialRosterValidation.test.ts",
    "test:migration:e2e": "MIGRATION_E2E=1 vitest run src/__tests__/e2e/officialRosterMigration.e2e.test.ts",
    "test:migration:rollback:e2e": "MIGRATION_ROLLBACK_E2E=1 MIGRATION_ROLLBACK_E2E_CONFIRM=YES vitest run src/__tests__/e2e/officialRosterRollback.e2e.test.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:training": "ts-node prisma/seed-training-demo.ts",
    "db:verify:training": "ts-node prisma/verify-training-demo.ts",
    "db:rollback:training": "ts-node prisma/rollback-training-demo.ts",
    "db:seed:training:habilitations": "ts-node prisma/seed-production-training-habilitations.ts",
    "db:verify:training:habilitations": "ts-node prisma/verify-production-training-habilitations.ts",
    "db:rollback:training:habilitations": "ts-node prisma/rollback-production-training-habilitations.ts",
    "seed:transportistas": "ts-node prisma/seed-transportistas-reales.ts",
    "seed:generadores": "ts-node prisma/seed-generadores-reales.ts",
    "seed:operadores": "ts-node prisma/seed-operadores-reales.ts",
    "documents:backfill": "ts-node scripts/backfill-legacy-documents.ts",
    "qa:seed-document-fixture": "ts-node scripts/qa-seed-document-fixture.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^5.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.3",
    "sharp": "^0.35.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.8.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.2",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0",
    "nodemon": "^3.0.1",
    "prisma": "^5.6.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^4.1.2",
    "vitest-mock-extended": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "trazabilidad",
    "residuos",
    "peligrosos",
    "dgfa",
    "mendoza"
  ],
  "author": "DGFA Mendoza",
  "license": "MIT"
}
