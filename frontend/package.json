{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:critical": "eslint playwright.config.ts src-v6/utils/userContext.ts src-v6/utils/impersonationNavigation.ts src-v6/utils/routeAccess.ts src-v6/contexts/AuthContext.tsx src-v6/contexts/ImpersonationContext.tsx src-v6/hooks/useConnectivity.ts src-v6/layouts/MainLayout.tsx src-v6/pages/auth/UserSwitcherPage.tsx src-v6/__tests__/hooks/useConnectivity.test.tsx e2e/safe-ui-quality.spec.ts e2e/safe-session-resilience.spec.ts e2e/user-context-persistence.spec.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:safe": "PLAYWRIGHT_SAFE_API=1 playwright test e2e/safe-ui-quality.spec.ts e2e/safe-session-resilience.spec.ts e2e/user-context-persistence.spec.ts",
    "test:e2e:safe:cross-browser": "PLAYWRIGHT_SAFE_API=1 PLAYWRIGHT_CROSS_BROWSER=1 playwright test e2e/safe-ui-quality.spec.ts e2e/safe-session-resilience.spec.ts e2e/user-context-persistence.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "dompurify": "3.4.15",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "js-yaml": "4.2.0",
    "fflate": "0.8.3"
  }
}
