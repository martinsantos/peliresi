# ============================================================
# SITREP Backend — Plantilla de Variables de Entorno
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env con credenciales reales.
# ============================================================

# ---- Entorno ----
NODE_ENV="development"           # development | production
PORT=3010                        # Puerto de escucha (PM2 usa 3010)

# ---- Base de datos ----
# Producción: trazabilidad_rrpp
# Desarrollo local: trazabilidad_dev (para no tocar prod accidentalmente)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trazabilidad_dev?schema=public"

# ---- JWT ----
# REQUERIDO en producción: generar con `openssl rand -base64 64`
JWT_SECRET="CHANGE_ME_use_openssl_rand_base64_64"
JWT_EXPIRES_IN="24h"

# REQUERIDO en producción: token distinto al JWT_SECRET
JWT_REFRESH_SECRET="CHANGE_ME_another_random_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- CORS ----
# URL del frontend (sin slash final)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# QR público de trazabilidad de inspecciones. Debe ser distinto de JWT_SECRET.
# Producción: `openssl rand -base64 64`
INSPECTION_TRACE_SECRET="CHANGE_ME_inspection_trace_secret"

# ---- Superadmin ----
# Email que puede acceder a endpoints /api/analytics/summary (solo estadísticas agregadas)
SUPER_ADMIN_EMAIL="admin@dgfa.mendoza.gov.ar"

# ---- Seeds ----
# Requerido si se ejecuta `prisma db seed` con NODE_ENV=production.
SEED_ADMIN_PASSWORD="CHANGE_ME_initial_admin_password"

# ---- Notificaciones (opcional) ----
ENABLE_ANALYTICS="true"

# ---- Email Queue + SMTP ----
# Kill switch: suprime envios SMTP pero sigue encolando en DB
DISABLE_EMAILS="false"

# Rate limits por destinatario por dia
EMAIL_DAILY_LIMIT_TRANSACCIONAL=10   # verificacion, password reset, aprobaciones
EMAIL_DAILY_LIMIT_ALERTA=6           # digests de alertas

# Flush timer (ms). Default 5 min.
EMAIL_FLUSH_INTERVAL_MS=300000

# Max intentos de envio antes de marcar SUPRIMIDO
EMAIL_MAX_RETRIES=3

# SMTP (Postfix local por defecto, o Brevo/Gmail)
SMTP_HOST="localhost"
SMTP_PORT=25
SMTP_USER=""                         # Brevo: "apikey" | Gmail: "tu-email@gmail.com"
SMTP_PASS=""                         # Brevo: "xkeysib-..." | Gmail: "app-password"
SMTP_FROM="SITREP <no-reply@sitrep.ultimamilla.com.ar>"

# ---- Blockchain (opcional) ----
# BLOCKCHAIN_PRIVATE_KEY=""          # Sepolia wallet private key
# BLOCKCHAIN_CONTRACT_ADDRESS=""     # Smart contract address
# BLOCKCHAIN_RPC_URL=""              # Sepolia RPC endpoint (Alchemy/Infura)

# ---- Logging ----
LOG_LEVEL="debug"                    # debug (dev) | info (prod)

# ---- Relevo de transporte (requiere migración de tramos) ----
MANIFEST_TRANSPORT_HANDOFF_ENABLED=false
# Frontend build opt-in: VITE_MANIFEST_TRANSPORT_HANDOFF_ENABLED=false
# GPS de varias cargas seleccionadas en un mismo móvil; requiere la migración de tramos.
TRANSPORT_MULTI_GPS_ENABLED=false
# Frontend build opt-in: VITE_TRANSPORT_MULTI_GPS_ENABLED=false
# Avisos transaccionales de manifiestos: sólo cuentas verificadas y dispositivos suscritos.
# No habilita VAPID ni correo, no envía en CAP y no reenvía historial.
PUSH_MANIFEST_NOTICES_ENABLED=false

# Propuestas ordinarias FIJO: creación por G/T/O y aprobación explícita de los tres.
# Independiente de MANIFEST_PARTY_REVIEW_ENABLED (revisión posterior de adendas/eventuales).
# Default cerrado. No convierte históricos; desactivarlo no elimina sus guardas persistentes.
MANIFEST_PROPOSALS_ENABLED=false
# Frontend: VITE_MANIFEST_PROPOSALS_ENABLED=false. No habilita CAP, correo ni push.

# Emisión explícita por operador; conserva PDFs emitidos aunque se deshabilite.
MANIFEST_CERTIFICATES_ENABLED=false
# Frontend: VITE_MANIFEST_CERTIFICATES_ENABLED=false. No activa CAP ni canales externos.
