    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
